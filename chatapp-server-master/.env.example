# ========================================================
# Chat Application Backend Environment Variables (.env)
# ========================================================

# Server Port
PORT=3000

# Node Environment: DEVELOPMENT or PRODUCTION
NODE_ENV=DEVELOPMENT

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/chattu
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/chattu?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/chattu

# JWT Signing Secret (Random secure string)
JWT_SECRET=super_secret_jwt_key_chattu_2026_change_in_production

# Secret key required to access the /admin dashboard
ADMIN_SECRET_KEY=admin12345

# Frontend Application URL (for CORS & Cookie authorization)
# Local: http://localhost:5173
# Production: https://your-frontend-deployment.onrender.com
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (For file uploads, avatars, status stories)
# Get your credentials at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
